# Everything the build writes
# (in any directory: a run started from the wrong directory makes one there)
out/
# build/build.mk's Wine prefix, generated rules and header dependencies
/.wine/
/.build/
# Monolith's project files put every output in a built/ directory
src/**/[Bb]uilt/
# the LithTech Jupiter SDK's source, copied from rez/ at build time by
# tools/jupitersrc.py (LICENSE-NOTES.md: not to be committed)
src/Game/Libs/WONAPI/
src/Game/Libs/ServerDir/CServerDir_Titan.cpp
src/Game/Libs/ServerDir/CServerDir_Titan.h
src/Game/Libs/ServerDir/TitanTest.cpp
src/Game/Libs/ServerDir/TitanTest.h
src/Game/Libs/ServerDir/WinSync.h
src/Game/Libs/ServerDir/stdafx.cpp
src/Game/Libs/ServerDir/stdafx.h
# generated by flex/bison at build time (src/Game/ObjectDLL/ObjectShared/)
src/Game/ObjectDLL/ObjectShared/AnimationLex.o
src/Game/ObjectDLL/ObjectShared/AnimationParse.o
src/Game/ObjectDLL/ObjectShared/AnimationLexSymbols.h

__pycache__/
*.log
!src/**/*.log
